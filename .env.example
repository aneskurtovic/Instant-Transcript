# ─── Instant Transcript configuration ───────────────────────────────────────
# Copy to `.env` and adjust. All values shown are the defaults.

# --- Whisper / transcription ---
# Model: tiny | base | small | medium | large-v3
#   - small (default): fast on CPU, works out of the box
#   - medium: better quality, slower on CPU
#   - large-v3: best quality (Bosnian/Croatian/Serbian etc.), GPU recommended
WHISPER_MODEL=small
# Device: cpu | cuda
DEVICE=cpu
# Compute type: int8 (CPU) | float16 (GPU)
COMPUTE_TYPE=int8

# --- TTL / link expiry ---
DEFAULT_TTL_HOURS=168     # 7 days
MAX_TTL_HOURS=720         # 30 days (upper bound for per-request TTL)

# --- Guardrails ---
MAX_DURATION_MIN=120      # reject videos longer than this

# --- Public URL (used to build shareable links) ---
# Set this to your real public origin when behind a tunnel / reverse proxy,
# e.g. https://transcripts.example.com
BASE_URL=http://localhost:8000

# --- Storage ---
DB_PATH=data/transcripts.db
TMP_DIR=data/tmp

# --- Cleanup loop ---
CLEANUP_INTERVAL_MIN=15

# --- Rate limiting (slowapi) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT=10/hour

# --- yt-dlp cookie fallback (optional; for YouTube bot checks) ---
# Path to a Netscape-format cookies file:
# YT_DLP_COOKIES=/path/to/cookies.txt
# OR pull cookies from an installed browser (chrome | firefox | edge | ...):
# YT_DLP_COOKIES_FROM_BROWSER=chrome
